+                **windows_environment(),
+                "PYTHONNOUSERSITE": "1",
+                "POTBOT_PARENT_KEYSTORE_SERVER_TOKEN": token,
+            },
+        )
+        try:
+            for _ in range(100):
+                if parent.poll() is not None:
+                    log.flush()
