# Installed as /etc/wsl.conf in the dedicated Potbot WSL distribution.
# This is defense in depth, NOT a Windows security boundary.
[boot]
systemd=true

[automount]
enabled=false
mountFsTab=false

[interop]
enabled=false
appendWindowsPath=false

[user]
# Run the host-side Potbot broker as the managed Linux service user.
default=synoperator
