+expected = sys.argv[2]
+payload = sys.stdin.buffer.read(512 * 1024 + 1)
+if len(payload) > 512 * 1024 or hashlib.sha256(payload).hexdigest() != expected:
+    raise SystemExit(64)
+path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
