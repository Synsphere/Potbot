diff --git a/src/potbot/syn_release/parent_keystore_client.py b/src/potbot/syn_release/parent_keystore_client.py
new file mode 100644
--- /dev/null
+++ b/src/potbot/syn_release/parent_keystore_client.py
@@ -0,0 +1,253 @@
+"""Authenticated WSL client for the parent node's Windows-backed keystore API.
+
+This module is deliberately stdlib-only.  The same client is used by the Syn
+host-custody compatibility executable and by the Secret Service façade.
+"""
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+import os
+import re
+import secrets
+import socket
+import sys
+from typing import Any
+
+REQUEST_PROFILE = "potbot.parent-keystore-request/1"
+RESPONSE_PROFILE = "potbot.parent-keystore-response/1"
+MAX_MESSAGE = 160_000
+_ENV = {
+    "host": "POTBOT_PARENT_KEYSTORE_HOST",
+    "port": "POTBOT_PARENT_KEYSTORE_PORT",
+    "session": "POTBOT_PARENT_KEYSTORE_SESSION",
+    "token": "POTBOT_PARENT_KEYSTORE_TOKEN",
+}
+_SESSION = re.compile(r"SynHostCustody-[a-f0-9]{32}\Z")
+_HEX64 = re.compile(r"[a-f0-9]{64}\Z")
+
+
+class ParentKeystoreError(RuntimeError):
+    """The parent keystore transport or authorization boundary refused a request."""
+
+
+def _canonical(value: object) -> bytes:
+    return json.dumps(
+        value,
+        ensure_ascii=True,
+        sort_keys=True,
+        separators=(",", ":"),
+        allow_nan=False,
+    ).encode("ascii")
+
+
+def _configuration() -> tuple[str, int, str, bytes]:
+    host = os.environ.get(_ENV["host"], "")
+    port_text = os.environ.get(_ENV["port"], "")
+    session = os.environ.get(_ENV["session"], "")
+    token_text = os.environ.get(_ENV["token"], "")
+    try:
+        port = int(port_text)
+        token = bytes.fromhex(token_text)
+    except ValueError:
+        raise ParentKeystoreError("Parent keystore session configuration is invalid") from None
+    try:
+        socket.inet_aton(host)
+    except OSError:
+        raise ParentKeystoreError("Parent keystore host address is invalid") from None
+    if (
+        not 1 <= port <= 65535
+        or _SESSION.fullmatch(session) is None
+        or _HEX64.fullmatch(token_text) is None
+        or len(token) != 32
+    ):
+        raise ParentKeystoreError("Parent keystore session configuration is invalid")
+    return host, port, session, token
+
+
+def _mac(token: bytes, value: dict[str, Any]) -> str:
+    return hmac.new(token, _canonical(value), hashlib.sha256).hexdigest()
+
+
+def build_request_for(
+    session: str, token: bytes, surface: str, body: dict[str, Any]
+) -> dict[str, Any]:
+    """Create one replay-resistant, HMAC-authenticated request envelope."""
+    if _SESSION.fullmatch(session) is None or len(token) != 32:
+        raise ParentKeystoreError("Parent keystore session configuration is invalid")
+    if surface not in {"secret-service", "syn-authenticator"} or not isinstance(body, dict):
+        raise ParentKeystoreError("Parent keystore request surface is invalid")
+    unsigned: dict[str, Any] = {
+        "profile": REQUEST_PROFILE,
+        "session": session,
+        "request_id": secrets.token_hex(32),
+        "surface": surface,
+        "body": body,
+    }
+    envelope = {**unsigned, "mac": _mac(token, unsigned)}
+    raw = _canonical(envelope) + b"\n"
+    if len(raw) > MAX_MESSAGE:
+        raise ParentKeystoreError("Parent keystore request exceeds size limit")
+    return envelope
+
+
+def build_request(surface: str, body: dict[str, Any]) -> tuple[dict[str, Any], bytes]:
+    _host, _port, session, token = _configuration()
+    return build_request_for(session, token, surface, body), token
+
+
+def request_with_config(
+    host: str,
+    port: int,
+    session: str,
+    token: bytes,
+    body: dict[str, Any],
+    *,
+    surface: str,
+    timeout: float = 30.0,
+) -> Any:
+    envelope = build_request_for(session, token, surface, body)
+    request_id = envelope["request_id"]
+    try:
+        with socket.create_connection((host, port), timeout=timeout) as channel:
+            channel.settimeout(timeout)
+            channel.sendall(_canonical(envelope) + b"\n")
+            stream = channel.makefile("rb", buffering=0)
+            raw = stream.readline(MAX_MESSAGE + 1)
+    except (OSError, TimeoutError) as error:
+        raise ParentKeystoreError("Parent keystore transport is unavailable") from error
+    if not raw or len(raw) > MAX_MESSAGE or not raw.endswith(b"\n"):
+        raise ParentKeystoreError("Parent keystore response is invalid")
+    try:
+        response = json.loads(raw)
+    except (ValueError, TypeError):
+        raise ParentKeystoreError("Parent keystore response is malformed") from None
+    if not isinstance(response, dict) or set(response) != {
+        "profile",
+        "request_id",
+        "response",
+        "mac",
+    }:
+        raise ParentKeystoreError("Parent keystore response has unknown fields")
+    unsigned = {
+        "profile": response["profile"],
+        "request_id": response["request_id"],
+        "response": response["response"],
+    }
+    if (
+        response["profile"] != RESPONSE_PROFILE
+        or response["request_id"] != request_id
+        or not isinstance(response["mac"], str)
+        or not hmac.compare_digest(response["mac"], _mac(token, unsigned))
+    ):
+        raise ParentKeystoreError("Parent keystore response authentication failed")
+    result = response["response"]
+    if not isinstance(result, dict) or set(result) not in ({"ok", "result"}, {"ok", "error"}):
+        raise ParentKeystoreError("Parent keystore result is invalid")
+    if result["ok"] is not True:
+        raise ParentKeystoreError(
+            "Parent keystore denied request: " + str(result.get("error", "unknown"))[:200]
+        )
+    return result["result"]
+
+
+def request(body: dict[str, Any], *, surface: str, timeout: float = 30.0) -> Any:
+    host, port, session, token = _configuration()
+    return request_with_config(
+        host, port, session, token, body, surface=surface, timeout=timeout
+    )
+
+
+def secret_get(service: str, account: str) -> str | None:
+    result = request(
+        {"op": "get", "service": service, "account": "slot", "slot": account},
+        surface="secret-service",
+    )
+    if result is not None and not isinstance(result, str):
+        raise ParentKeystoreError("Parent secret result must be text or null")
+    return result
+
+
+def secret_set(service: str, account: str, value: str) -> None:
+    result = request(
+        {
+            "op": "set",
+            "service": service,
+            "account": "slot",
+            "slot": account,
+            "value": value,
+        },
+        surface="secret-service",
+    )
+    if result is not True:
+        raise ParentKeystoreError("Parent secret write was not acknowledged")
+
+
+def secret_delete(service: str, account: str) -> bool:
+    result = request(
+        {"op": "delete", "service": service, "account": "slot", "slot": account},
+        surface="secret-service",
+    )
+    if type(result) is not bool:
+        raise ParentKeystoreError("Parent secret deletion response is invalid")
+    return result
+
+
+def secret_search(service: str, account: str | None = None) -> list[str]:
+    body: dict[str, Any] = {"op": "search", "service": service, "account": "slot"}
+    if account is not None:
+        body["slot"] = account
+    result = request(body, surface="secret-service")
+    if not isinstance(result, list) or any(not isinstance(item, str) for item in result):
+        raise ParentKeystoreError("Parent secret search response is invalid")
+    return result
+
+
+def _legacy_surface(body: dict[str, Any]) -> str:
+    return "secret-service" if body.get("op") in {"get", "set"} else "syn-authenticator"
+
+
+def _legacy_failure(label: str) -> int:
+    print("SYN_HOST_CUSTODY_FAILURE:" + label, file=sys.stderr)
+    return 4
+
+
+def _legacy_main() -> int:
+    # Syn 0.11 invokes this compatibility executable with PowerShell-shaped
+    # arguments. They are deliberately ignored except that the retained pipe
+    #/session identifier must agree with the authenticated parent session.
+    try:
+        if "-Pipe" in sys.argv:
+            index = sys.argv.index("-Pipe")
+            supplied = sys.argv[index + 1]
+            if supplied != os.environ.get("POTBOT_PARENT_KEYSTORE_SESSION"):
+                return _legacy_failure("input-invalid")
+        raw = sys.stdin.buffer.readline(MAX_MESSAGE + 1)
+        if not raw or len(raw) > MAX_MESSAGE:
+            return _legacy_failure("input-invalid")
+        body = json.loads(raw)
+        if not isinstance(body, dict):
+            return _legacy_failure("input-invalid")
+        result = request(body, surface=_legacy_surface(body), timeout=310.0)
+        sys.stdout.write(
+            json.dumps({"ok": True, "result": result}, sort_keys=True, separators=(",", ":"))
+            + "\n"
+        )
+        return 0
+    except ParentKeystoreError:
+        return _legacy_failure("connect-failed")
+    except (ValueError, TypeError, IndexError):
+        return _legacy_failure("input-invalid")
+
+
+def main() -> int:
+    if "--secret-service-daemon" in sys.argv[1:]:
+        from potbot.syn_release.secret_service_proxy import main as secret_service_main
+
+        return secret_service_main()
+    return _legacy_main()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/potbot/syn_release/parent_keystore_server.py b/src/potbot/syn_release/parent_keystore_server.py
new file mode 100644
--- /dev/null
+++ b/src/potbot/syn_release/parent_keystore_server.py
@@ -0,0 +1,247 @@
+"""Windows parent-node keystore RPC server for the managed WSL runtime.
+
+Executed with Syn's pinned host-custody Python environment. The server owns the
+DPAPI vault and all authorization decisions. WSL receives only an authenticated
+request/response channel; root/private material is never exported.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import hmac
+import json
+import os
+import re
+import socket
+from typing import Any
+
+from syn_host_custody.broker import WindowsVault, host_approve
+from syn_host_custody.core import Authority, MAX_REQUEST, root_slot, safe_ref, safe_slot
+from syn_host_custody.owner import OwnerProcess
+
+REQUEST_PROFILE = "potbot.parent-keystore-request/1"
+RESPONSE_PROFILE = "potbot.parent-keystore-response/1"
+MAX_MESSAGE = 160_000
+_SESSION = re.compile(r"SynHostCustody-[a-f0-9]{32}\Z")
+_HEX64 = re.compile(r"[a-f0-9]{64}\Z")
+_AUTH_OPS = {
+    "health",
+    "create",
+    "identity",
+    "sign",
+    "candidates",
+    "device_commitment",
+    "group_key",
+    "peer_record",
+    "dag_anchor",
+    "dag_witness_anchor",
+}
+_SECRET_OPS = {"get", "set", "delete", "search"}
+
+
+def canonical(value: object) -> bytes:
+    return json.dumps(
+        value,
+        ensure_ascii=True,
+        sort_keys=True,
+        separators=(",", ":"),
+        allow_nan=False,
+    ).encode("ascii")
+
+
+def mac(token: bytes, value: dict[str, Any]) -> str:
+    return hmac.new(token, canonical(value), hashlib.sha256).hexdigest()
+
+
+def _secret_identity(body: dict[str, Any]) -> tuple[str, str | None]:
+    service = body.get("service")
+    slot = body.get("slot")
+    if not safe_ref(service) or body.get("account") != "slot":
+        raise ValueError("Parent secret request has invalid service/account scope")
+    if slot is not None and (not safe_slot(slot) or root_slot(slot)):
+        raise ValueError("Parent secret request targets a protected slot")
+    return service, slot
+
+
+def _delete(vault: WindowsVault, service: str, slot: str) -> bool:
+    key = service + "/" + slot
+    previous = vault.data
+    slots = previous["slots"]
+    if key not in slots:
+        return False
+    vault.data = {
+        **previous,
+        "slots": {name: value for name, value in slots.items() if name != key},
+    }
+    try:
+        vault._persist()
+    except BaseException:
+        vault.data = previous
+        vault._write_failed = True
+        raise
+    return True
+
+
+def _search(vault: WindowsVault, service: str, slot: str | None) -> list[str]:
+    if slot is not None:
+        return [] if vault.get_slot(service, slot) is None else [slot]
+    prefix = service + "/"
+    result = []
+    for key in vault.data["slots"]:
+        if not key.startswith(prefix):
+            continue
+        candidate = key[len(prefix):]
+        if safe_slot(candidate) and not root_slot(candidate):
+            result.append(candidate)
+    return sorted(result)
+
+
+def dispatch(authority: Authority, vault: WindowsVault, surface: str, body: dict[str, Any]) -> Any:
+    if not isinstance(body, dict):
+        raise ValueError("Parent keystore body must be an object")
+    operation = body.get("op")
+    if surface == "syn-authenticator":
+        if operation not in _AUTH_OPS:
+            raise ValueError("Parent authenticator operation is not permitted")
+        # Syn's signed Authority performs all pin checks, transcript-domain
+        # checks, native approval prompts and non-exportability enforcement.
+        return authority.request(body)
+    if surface != "secret-service" or operation not in _SECRET_OPS:
+        raise ValueError("Parent keystore request surface is not permitted")
+    service, slot = _secret_identity(body)
+    if operation in {"get", "set"}:
+        # Keep generic secret storage behind the parent Authority as well.
+        return authority.request(body)
+    if operation == "delete":
+        assert slot is not None
+        return _delete(vault, service, slot)
+    return _search(vault, service, slot)
+
+
+def _read_request(channel: socket.socket) -> bytes:
+    data = bytearray()
+    while b"\n" not in data:
+        chunk = channel.recv(min(4096, MAX_MESSAGE + 1 - len(data)))
+        if not chunk:
+            break
+        data.extend(chunk)
+        if len(data) > MAX_MESSAGE:
+            raise ValueError("Parent keystore request exceeds size limit")
+    if b"\n" not in data:
+        raise ValueError("Parent keystore request is incomplete")
+    line, trailing = bytes(data).split(b"\n", 1)
+    if trailing.strip():
+        raise ValueError("Parent keystore request has trailing data")
+    return line
+
+
+def _response(token: bytes, request_id: str, response: dict[str, Any]) -> bytes:
+    unsigned = {
+        "profile": RESPONSE_PROFILE,
+        "request_id": request_id,
+        "response": response,
+    }
+    return canonical({**unsigned, "mac": mac(token, unsigned)}) + b"\n"
+
+
+def serve(
+    host: str,
+    guest: str,
+    port: int,
+    session: str,
+    token: bytes,
+    owner_pid: int,
+    owner_created: int,
+) -> None:
+    replay: set[str] = set()
+    with OwnerProcess(owner_pid, owner_created), WindowsVault() as vault:
+        authority = Authority(vault, approve=host_approve)
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as server:
+            server.setsockopt(socket.SOL_SOCKET, socket.SO_EXCLUSIVEADDRUSE, 1)
+            server.bind((host, port))
+            server.listen(8)
+            while True:
+                channel, peer = server.accept()
+                with channel:
+                    channel.settimeout(330)
+                    request_id = ""
+                    try:
+                        if peer[0] != guest:
+                            raise ValueError("Parent keystore rejected a non-WSL peer")
+                        raw = _read_request(channel)
+                        envelope = json.loads(raw)
+                        if not isinstance(envelope, dict) or set(envelope) != {
+                            "profile",
+                            "session",
+                            "request_id",
+                            "surface",
+                            "body",
+                            "mac",
+                        }:
+                            raise ValueError("Parent keystore envelope has unknown fields")
+                        request_id = envelope["request_id"]
+                        unsigned = {
+                            name: envelope[name]
+                            for name in ("profile", "session", "request_id", "surface", "body")
+                        }
+                        if (
+                            envelope["profile"] != REQUEST_PROFILE
+                            or envelope["session"] != session
+                            or not isinstance(request_id, str)
+                            or _HEX64.fullmatch(request_id) is None
+                            or request_id in replay
+                            or not isinstance(envelope["mac"], str)
+                            or not hmac.compare_digest(envelope["mac"], mac(token, unsigned))
+                        ):
+                            raise ValueError("Parent keystore authentication failed")
+                        replay.add(request_id)
+                        if len(replay) > 8192:
+                            # Session request IDs are random 256-bit values; a bounded
+                            # replay window is enough without growing forever.
+                            replay.pop()
+                        result = dispatch(authority, vault, envelope["surface"], envelope["body"])
+                        response = {"ok": True, "result": result}
+                    except (KeyError, TypeError, ValueError, UnicodeError, OSError) as error:
+                        response = {"ok": False, "error": str(error)[:200]}
+                    if _HEX64.fullmatch(request_id or "") is None:
+                        request_id = "0" * 64
+                    channel.sendall(_response(token, request_id, response))
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--host", required=True)
+    parser.add_argument("--guest", required=True)
+    parser.add_argument("--port", type=int, required=True)
+    parser.add_argument("--session", required=True)
+    parser.add_argument("--owner-pid", type=int, required=True)
+    parser.add_argument("--owner-created", type=int, required=True)
+    args = parser.parse_args(argv)
+    try:
+        socket.inet_aton(args.host)
+        socket.inet_aton(args.guest)
+        token_text = os.environ.get("POTBOT_PARENT_KEYSTORE_SERVER_TOKEN", "")
+        token = bytes.fromhex(token_text)
+    except (OSError, ValueError):
+        parser.error("invalid parent keystore network/session argument")
+    if (
+        not 1024 <= args.port <= 65535
+        or _SESSION.fullmatch(args.session) is None
+        or _HEX64.fullmatch(token_text) is None
+        or len(token) != 32
+    ):
+        parser.error("invalid parent keystore network/session argument")
+    serve(
+        args.host,
+        args.guest,
+        args.port,
+        args.session,
+        token,
+        args.owner_pid,
+        args.owner_created,
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
